<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Enterprise Parallel Cross-Browser Suite" parallel="tests" thread-count="2" verbose="1">
    <listeners>
        <listener class-name="com.enterprise.framework.listeners.TestListener"/>
        <listener class-name="com.enterprise.framework.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="Chrome Execution" parallel="methods" thread-count="2">
        <parameter name="browser" value="chrome"/>
        <parameter name="headless" value="true"/>
        <classes>
            <class name="com.enterprise.framework.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Firefox Execution" parallel="methods" thread-count="2">
        <parameter name="browser" value="firefox"/>
        <parameter name="headless" value="true"/>
        <classes>
            <class name="com.enterprise.framework.tests.LoginTest"/>
        </classes>
    </test>
</suite>
