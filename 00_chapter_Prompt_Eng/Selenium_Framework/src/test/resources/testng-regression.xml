<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Enterprise CRM Full Regression Suite" verbose="1">
    <listeners>
        <listener class-name="com.enterprise.framework.listeners.TestListener"/>
        <listener class-name="com.enterprise.framework.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="Regression Tests">
        <parameter name="browser" value="chrome"/>
        <parameter name="headless" value="true"/>
        <packages>
            <package name="com.enterprise.framework.tests"/>
        </packages>
    </test>
</suite>
