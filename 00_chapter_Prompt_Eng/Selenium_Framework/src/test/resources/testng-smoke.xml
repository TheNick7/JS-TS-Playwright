<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Enterprise CRM Smoke Test Suite" verbose="1">
    <listeners>
        <listener class-name="com.enterprise.framework.listeners.TestListener"/>
        <listener class-name="com.enterprise.framework.listeners.AnnotationTransformer"/>
    </listeners>

    <test name="Smoke Tests - Chrome">
        <parameter name="browser" value="chrome"/>
        <parameter name="headless" value="true"/>
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.enterprise.framework.tests.LoginTest"/>
        </classes>
    </test>
</suite>
